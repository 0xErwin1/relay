{
  "info": {
    "_postman_id": "abc-123",
    "name": "Basic Collection"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Token",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["console.log('before');"] }
            },
            {
              "listen": "test",
              "script": { "exec": ["pm.test('ok', () => true);"] }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "secret-token" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"grant\":\"client\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://api.example.com/token",
              "host": ["api", "example", "com"],
              "path": ["token"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Trace", "value": "off", "disabled": true }
            ],
            "description": "Fetches a token.",
            "response": []
          }
        },
        {
          "name": "Get Token",
          "request": {
            "method": "GET",
            "url": "https://api.example.com/token/check"
          }
        }
      ]
    },
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [{ "key": "name", "value": "Ada" }]
        },
        "url": {
          "host": ["api", "example", "com"],
          "path": ["users"],
          "query": [
            { "key": "sendWelcome", "value": "true" },
            { "key": "dryRun", "value": "yes", "disabled": true }
          ]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://api.example.com" },
    { "key": "apiKey", "value": "hunter2", "type": "secret" }
  ],
  "auth": { "type": "noauth" }
}
